{
  "expo": {
    "name": "WolFlex",
    "slug": "WolFlex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/WolfAlone.png",
    "scheme": "wolflex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/WolfAlone.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/WolfAlone.png",
        "monochromeImage": "./assets/images/WolfAlone.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.ambiscoe.WolFlex"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/WolfAlone.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/WolfAlone.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "WolFlex needs access to your photos so you can choose a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
